rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function userRole() {
      return request.auth != null && request.auth.token.role is string ? request.auth.token.role : '';
    }

    function isAuthor() {
      return userRole() == 'author';
    }

    function isEditor() {
      return userRole() == 'editor';
    }

    function isAdmin() {
      return userRole() == 'admin';
    }

    function isValidStatus(status) {
      return status in ['draft', 'review', 'published', 'archived'];
    }

    function canCreateContent() {
      return request.auth != null &&
        (isAuthor() || isEditor() || isAdmin()) &&
        isValidStatus(request.resource.data.status) &&
        request.resource.data.status == 'draft';
    }

    function canUpdateContent() {
      return request.auth != null &&
        (isAuthor() || isEditor() || isAdmin()) &&
        isValidStatus(resource.data.status) &&
        isValidStatus(request.resource.data.status) &&
        (
          (isAuthor() && resource.data.status == 'draft' && request.resource.data.status in ['draft', 'review']) ||
          (isEditor() && (
            (resource.data.status == 'review' && request.resource.data.status in ['draft', 'published']) ||
            (resource.data.status == 'published' && request.resource.data.status == 'archived')
          )) ||
          isAdmin()
        );
    }

    // ---------------------------------------------------------------
    // Content manifest — public read, no client write
    // ---------------------------------------------------------------
    match /contentManifest/{env} {
      allow read: if true;
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // Compendium collections — public read for published docs,
    // role-gated client writes (imports use Admin SDK and bypass rules)
    // ---------------------------------------------------------------
    match /spells/{docId} {
      allow read: if resource.data.status == 'published';
      allow create: if canCreateContent();
      allow update: if canUpdateContent();
      allow delete: if isAdmin();
    }
    match /schools/{docId} {
      allow read: if resource.data.status == 'published';
      allow create: if canCreateContent();
      allow update: if canUpdateContent();
      allow delete: if isAdmin();
    }
    match /effects/{docId} {
      allow read: if resource.data.status == 'published';
      allow create: if canCreateContent();
      allow update: if canUpdateContent();
      allow delete: if isAdmin();
    }
    match /actions/{docId} {
      allow read: if resource.data.status == 'published';
      allow create: if canCreateContent();
      allow update: if canUpdateContent();
      allow delete: if isAdmin();
    }
    match /skills/{docId} {
      allow read: if resource.data.status == 'published';
      allow create: if canCreateContent();
      allow update: if canUpdateContent();
      allow delete: if isAdmin();
    }
    match /archetypes/{docId} {
      allow read: if resource.data.status == 'published';
      allow create: if canCreateContent();
      allow update: if canUpdateContent();
      allow delete: if isAdmin();
    }
    match /basics/{docId} {
      allow read: if resource.data.status == 'published';
      allow create: if canCreateContent();
      allow update: if canUpdateContent();
      allow delete: if isAdmin();
    }
    match /action_types/{docId} {
      allow read: if resource.data.status == 'published';
      allow create: if canCreateContent();
      allow update: if canUpdateContent();
      allow delete: if isAdmin();
    }
    match /combat_components/{docId} {
      allow read: if resource.data.status == 'published';
      allow create: if canCreateContent();
      allow update: if canUpdateContent();
      allow delete: if isAdmin();
    }
    match /craft_components/{docId} {
      allow read: if resource.data.status == 'published';
      allow create: if canCreateContent();
      allow update: if canUpdateContent();
      allow delete: if isAdmin();
    }
    match /craft_professions/{docId} {
      allow read: if resource.data.status == 'published';
      allow create: if canCreateContent();
      allow update: if canUpdateContent();
      allow delete: if isAdmin();
    }
    match /craft_specializations/{docId} {
      allow read: if resource.data.status == 'published';
      allow create: if canCreateContent();
      allow update: if canUpdateContent();
      allow delete: if isAdmin();
    }
    match /recipe_types/{docId} {
      allow read: if resource.data.status == 'published';
      allow create: if canCreateContent();
      allow update: if canUpdateContent();
      allow delete: if isAdmin();
    }
    match /recipes/{docId} {
      allow read: if resource.data.status == 'published';
      allow create: if canCreateContent();
      allow update: if canUpdateContent();
      allow delete: if isAdmin();
    }

    // News — public read for published, role-gated client writes
    match /news/{docId} {
      allow read: if resource.data.status == 'published';
      allow create: if canCreateContent();
      allow update: if canUpdateContent();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // User data — owner-only (legacy + new app: profile, characters, dice)
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /characters/{characterId} {
        allow read, write: if isOwner(userId);
      }
      match /diceRolls/{rollId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---------------------------------------------------------------
    // Lobby & collections (legacy realtime; new app drops lobby —
    // kept so the legacy site keeps working until it is retired)
    // ---------------------------------------------------------------
    match /lobbies/{lobbyId} {
      allow read, write: if request.auth != null;

      match /members/{memberId} {
        allow read, write: if request.auth != null;
      }
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
      match /boards/{boardId} {
        allow read, write: if request.auth != null;

        match /strokes/{strokeId} {
          allow read, write: if request.auth != null;
        }
      }
      match /canvas/{strokeId} {
        allow read, write: if request.auth != null;
      }
      match /canvasMeta/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    // ---------------------------------------------------------------
    // Telemetry & audit
    // ---------------------------------------------------------------
    match /auditLogs/{docId} {
      allow read, write: if false;
    }

    match /content_publication_log/{docId} {
      allow read: if request.auth != null && (isEditor() || isAdmin());
      allow write: if false;
    }

    match /client_telemetry/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (isEditor() || isAdmin());
      allow update, delete: if false;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
