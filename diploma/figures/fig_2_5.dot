digraph ER {
  rankdir=TB; bgcolor="white"; splines=true; nodesep=0.4; ranksep=0.8;
  node [shape=record, fontname="Arial", fontsize=10, style="filled", fillcolor="white", color="black"];
  edge [fontname="Arial", fontsize=9, color="black", arrowhead=none];

  School     [label="{Школа магии|id\lназвание\lописание\l}"];
  Spell      [label="{Заклинание|id\lназвание\lдистанция\lурон\l}"];
  Effect     [label="{Эффект|id\lназвание\lтип\l}"];
  ActionType [label="{Тип действия|id\lназвание\l}"];
  Archetype  [label="{Архетип|id\lназвание\l}"];

  Profession     [label="{Профессия|id\lназвание\l}"];
  Specialization [label="{Специализация|id\lназвание\l}"];
  Recipe         [label="{Рецепт|id\lназвание\lрезультат\l}"];
  RecipeType     [label="{Тип рецепта|id\lназвание\l}"];
  CraftComp      [label="{Компонент крафта|id\lназвание\l}"];

  User      [label="{Пользователь|uid\lроль\l}"];
  Character [label="{Персонаж|id\lимя\lхарактеристики\l}"];

  School    -> Spell      [label="1 — N"];
  Spell     -> Effect     [label="N — N"];
  Spell     -> ActionType [label="N — 1"];
  Archetype -> School     [label="N — N"];

  Profession     -> Specialization [label="1 — N"];
  Specialization -> Recipe         [label="1 — N"];
  Recipe         -> RecipeType     [label="N — 1"];
  Recipe         -> CraftComp      [label="N — N"];

  User      -> Character [label="1 — N"];
  Character -> Spell     [label="N — N"];
  Character -> School    [label="N — N"];
}
