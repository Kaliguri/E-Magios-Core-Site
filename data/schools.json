  {
    "id": "базовая-аркана",
    "name": "Базовая Аркана",
    "rarity": "Редкая",
    "properties": [],
    "description": "Начальная школа магии, подходящая для обучения новых магов. Её простота обманчива, ведь множество боевых магов используют Базовую Аркану за её исключительную эффективность. Её главным преимуществом и её недостатком является простота. Она требует мало ресурсов, но не обладает особыми эффектами.",
    "principles": [
      "Простота. Одно заклинание должно иметь один эффект.",
      "Чистая сила. Накладываемые эффекты могут иметь только физическую природу. Урон только Арканой, Дробящий, Колющий и Режущий."
    ],
    "features": [
      "Эффективность. Основной эффект усилен.",
      "Обучаемость. Скорость создания фирменных заклинаний усиленна."
    ],
    "educationalSpells": [
      "Выстрел Арканы",
      "Щит Арканы",
      "Цепи Арканы"
    ]
  },
